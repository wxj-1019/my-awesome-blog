# 数据库配置 - 请使用强密码
DATABASE_URL=postgresql://postgres:YOUR_STRONG_PASSWORD@localhost:5432/my_awesome_blog
DATABASE_POOL_SIZE=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_MAX_OVERFLOW=10

# 应用配置
APP_NAME=My Awesome Blog
APP_VERSION=1.0.0
LOG_DIR=logs
STATIC_FILES_DIR=static
MAX_CONTENT_LENGTH=10485760
# 开发模式 (生产环境设为 false)
DEBUG=false

# JWT 密钥 - 必须更换为至少 32 字节的强随机密钥
# 生成命令: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_YOUR_STRONG_SECRET_KEY_MIN_32_BYTES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_SPECIAL_CHARS=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_POOL_SIZE=20

# CORS 配置（JSON 列表，开发需同时含 localhost 与 127.0.0.1）
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]

# 阿里云 OSS 配置（保留兼容，实际存储已切换 MinIO）
ALIBABA_CLOUD_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
ALIBABA_CLOUD_ACCESS_KEY_SECRET=YOUR_ACCESS_KEY_SECRET
ALIBABA_CLOUD_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
ALIBABA_CLOUD_OSS_BUCKET_NAME=my-awesome-blog
ALIBABA_CLOUD_OSS_REGION=oss-cn-hangzhou
ALIBABA_CLOUD_OSS_CDN_DOMAIN=

# MinIO 配置（对象存储：替代阿里云 OSS）
# 容器内为 http://minio:9000，本地开发为 http://localhost:9000
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=YOUR_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=YOUR_MINIO_SECRET_KEY
MINIO_BUCKET_NAME=my-awesome-blog
# 文件对外访问基础 URL（经 nginx /minio/ 反代，如 http://your-domain）
MINIO_PUBLIC_BASE_URL=http://localhost

# 邮件服务配置 (可选)
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=your-email@example.com
FRONTEND_URL=http://localhost:3000

# 限流配置
RATE_LIMIT_DEFAULT=1000/hour
RATE_LIMIT_AUTHENTICATED=2000/hour
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute

# 缓存配置（秒）
CACHE_DEFAULT_TTL=3600
CACHE_ARTICLES_TTL=1800
CACHE_USERS_TTL=900

# LLM 配置
LLM_DEFAULT_MODEL=deepseek-v4-flash
LLM_TIMEOUT=120
LLM_MAX_RETRIES=5
LLM_STREAM_ENABLED=true

# DeepSeek 配置
# 模型可选：deepseek-v4-flash（快速版，日常对话）/ deepseek-v4-pro（专业版，复杂推理）
# 注：deepseek-chat / deepseek-reasoner 已于 2026-07-24 弃用，分别对应 v4-flash 非思考/思考模式
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# GLM (智谱AI) 配置
GLM_API_KEY=your_glm_api_key_here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-plus

# Qwen (通义千问) 配置
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# LangChain / LangSmith 配置（可选）
LANGCHAIN_ENABLED=true
LANGCHAIN_VERBOSE=false
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=my-awesome-blog

# 封面配图图源（auto | pexels | unsplash | openverse）
COVER_SOURCE=pexels
PEXELS_API_KEY=your_pexels_api_key_here
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
COVER_PER_PAGE=6

# RunningHub 标准模型 API（图片/视频生成工具页；异步任务模式，key 只存后端）
RUNNINGHUB_API_KEY=your_runninghub_api_key_here
RUNNINGHUB_BASE_URL=https://www.runninghub.cn/openapi/v2
# 图片端点已废弃，按 model/mode 动态拼接；保留兼容旧配置
RUNNINGHUB_IMAGE_ENDPOINT=rhart-image-g-2-official/text-to-image
RUNNINGHUB_VIDEO_ENDPOINT=rhart-video-v3.1-fast/text-to-video
RUNNINGHUB_ACCOUNT_URL=https://www.runninghub.cn/uc/openapi/accountStatus

# Prompt 管理配置
PROMPT_DEFAULT_VERSION=v1
PROMPT_MAX_VERSIONS=10
PROMPT_AB_TEST_ENABLED=true
PROMPT_AB_TEST_TRAFFIC_SPLIT=0.5

# 上下文管理配置
CONTEXT_DEFAULT_WINDOW_SIZE=10
CONTEXT_MAX_WINDOW_SIZE=50
CONTEXT_SUMMARIZATION_ENABLED=true
CONTEXT_SUMMARIZATION_THRESHOLD=20
CONTEXT_SUMMARIZATION_MODEL=deepseek-v4-flash

# 记忆管理配置
MEMORY_SHORT_TERM_ENABLED=true
MEMORY_SHORT_TERM_TTL=3600
MEMORY_LONG_TERM_ENABLED=true
MEMORY_LONG_TERM_MAX_RESULTS=5
MEMORY_LONG_TERM_THRESHOLD=0.7
MEMORY_VECTOR_DIMENSION=1536

# 会话管理配置
CONVERSATION_MAX_MESSAGES=1000
CONVERSATION_AUTO_TITLE_ENABLED=true
CONVERSATION_TITLE_MODEL=deepseek-v4-flash

# 租户配置（个人站定位：仅 AI 侧按租户作用域）
TENANT_ENABLED=true
TENANT_DEFAULT_MAX_STORAGE_MB=1024
TENANT_DEFAULT_CONTEXT_WINDOW_SIZE=10

# 天气 API (ALAPI)
ALAPI_TOKEN=your_alapi_token_here

# 分页配置
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
MIN_PAGE_SIZE=1

# 上传安全配置
UPLOAD_ALLOWED_EXTENSIONS=[".jpg",".jpeg",".png",".gif",".webp"]
# 单个文件最大大小（字节，图片等常规文件 10MB）
UPLOAD_MAX_FILE_SIZE=10485760
# 视频文件最大大小（字节 200MB）
UPLOAD_MAX_VIDEO_FILE_SIZE=209715200
# 音频文件最大大小（字节 100MB）
UPLOAD_MAX_AUDIO_FILE_SIZE=104857600
# 批量上传总大小限制（字节 50MB）
UPLOAD_MAX_BATCH_SIZE=52428800
UPLOAD_MAX_FILES_PER_BATCH=10

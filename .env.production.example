# 生产环境配置示例（复制为 .env.production 后填写真实值）
# 切勿将含真实密钥的 .env.production 提交到 Git

# 数据库
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=my_awesome_blog
DATABASE_URL=postgresql://postgres:change-me-strong-password@postgres:5432/my_awesome_blog

# JWT（至少 32 字符的强随机串）
SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars

# 前端公网地址（按实际域名/IP 修改）
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_API_BASE_URL=https://example.com

# CORS（JSON 数组字符串，与前端来源一致）
BACKEND_CORS_ORIGINS=["https://example.com"]

# Redis（Compose 内网服务名一般为 redis）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# 可选：LLM（需由 docker-compose.prod.yml 注入 backend）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 可选：RunningHub 文生图/文生视频（图片/视频生成工具页 /tools/image-gen）
# 平台：https://www.runninghub.cn —— 个人中心生成 API Key；工作流页复制工作流 id
# 未配置时创建任务接口返回 400「生成服务未配置」
RUNNINGHUB_API_KEY=
# API 基础地址（一般无需修改）
RUNNINGHUB_BASE_URL=https://www.runninghub.cn/api/v1
# 文生图 / 文生视频工作流模板 id（各自的工作流需包含提示词输入节点）
RUNNINGHUB_IMAGE_WORKFLOW_ID=
RUNNINGHUB_VIDEO_WORKFLOW_ID=
# 工作流的提示词输入参数名（依工作流节点变量名而定，一般即 prompt）
RUNNINGHUB_IMAGE_INPUT_KEY=prompt
RUNNINGHUB_VIDEO_INPUT_KEY=prompt

# 可选：天气 ALAPI（https://www.alapi.cn/）
# 未配置时 /api/v1/weather/current 返回 400：ALAPI_TOKEN 未配置
ALAPI_TOKEN=

# 可选：阿里云 OSS
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
ALIBABA_CLOUD_OSS_BUCKET_NAME=
ALIBABA_CLOUD_OSS_REGION=oss-cn-hangzhou
ALIBABA_CLOUD_OSS_CDN_DOMAIN=

# 调试（生产必须为 False）
DEBUG=False
